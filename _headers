# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# NOTE ON CACHING AND CUSTOM DOMAINS
# A *.pages.dev URL bypasses the zone CDN cache; a custom domain does not.
# So these rules only really bite on the custom domain — which is exactly
# where a stale file is most confusing. Asset filenames here are stable
# (work-reach.mp4 is always work-reach.mp4), so a long max-age means a
# swapped-in file keeps serving the old bytes until it expires.
# Short cache while the deck is still being assembled. Once the media is
# final and you stop touching it, raising this to 86400 is safe.
/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# The page itself is the thing that changes — never let it go stale.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noindex, nofollow
